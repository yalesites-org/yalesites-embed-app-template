{
  "entryHtml": "placeholder.html",
  "iframeTitle": "{{APP_TITLE}}",
  "initialHeight": 600,
  "useIframe": true,
  "allowList": [
    "allow-scripts",
    "allow-same-origin"
  ],
  "cspDirectives": {
    "script-src": "'self'",
    "style-src": "'self' 'unsafe-inline'",
    "img-src": "'self' data:",
    "default-src": "'self'"
  }
}
